# KNOCK environment variables
# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase — create a free project at https://supabase.com (see README for the
# full setup). Leave empty to run in guest mode.
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> anon public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
